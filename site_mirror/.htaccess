# Accidental GitHub Pages upload to Plesk: /raskrutov-kz-2026/... → /...
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^raskrutov-kz-2026/(.*)$ /$1 [R=301,L]
  RewriteRule ^raskrutov-kz-2026/?$ / [R=301,L]
</IfModule>

# 301: legacy /pages/*.html -> pretty URLs
